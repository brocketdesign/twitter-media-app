# Copy to .env (gitignored) and fill in. Everything here stays on this machine.
#
# API key for myaimodelmanager.com — create one at /api/docs on the site, or
# under your account's API keys. Format: clx_…
#
# This is only a fallback: a key typed into the app's Admin page is stored in
# the local SQLite DB and takes precedence over this value.
MYAIMODELMANAGER_API_KEY=

# Override only when pointing at a local or staging instance.
# MYAIMODELMANAGER_BASE_URL=http://localhost:3000

# --- public site (set these once the app is deployed) -----------------
# Origin the app is served from. Canonical URLs, Open Graph tags, robots.txt
# and sitemap.xml are built from it. Unset, they fall back to the request
# host, which is fine locally but wrong behind a proxy.
# SITE_URL=https://your-domain.com

# Where the "Try MyAIModelManager" promo buttons point.
# BRAND_URL=https://myaimodelmanager.com
